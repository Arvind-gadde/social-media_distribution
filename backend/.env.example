# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-64
APP_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:root@db:5432/social-media-distribution

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── Token Encryption (Fernet) — protects platform OAuth tokens at rest ────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=CHANGE-ME-generate-with-fernet

# ── OAuth — Google Login ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Object Storage (MinIO locally, S3 in production) ─────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=contentflow-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/contentflow-media

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Vector store (Qdrant) ─────────────────────────────────────────────────
# QDRANT_URL=http://qdrant:6333 inside docker-compose. Leave empty to disable.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NICHE=contentflow_niches
QDRANT_COLLECTION_CONTENT=contentflow_content
QDRANT_COLLECTION_DOCUMENTS=contentflow_documents
QDRANT_VECTOR_SIZE=1536

# ── Embeddings ────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=96
EMBEDDING_CACHE_TTL=86400

# ── Platform OAuth Apps ───────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ── Web Push Notifications ────────────────────────────────────────────────
# Generate: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_key, v.public_key)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=admin@yourapp.com

# ── Stripe Billing (Phase 11) ─────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products in Stripe Dashboard)
PRICE_PRO_MONTHLY=price_...
PRICE_PRO_YEARLY=price_...
PRICE_BUSINESS_MONTHLY=price_...
PRICE_BUSINESS_YEARLY=price_...

# ── AI Providers (Phase 14) ───────────────────────────────────────────────
# OpenAI (already defined above for backward compatibility)
# OPENAI_API_KEY=sk-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GEMINI_API_KEY=...

# OpenRouter (cheap-tier hub: DeepSeek, Llama, Qwen via one key)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── LLM Routing Defaults (Tier-based routing) ─────────────────────────────
# Used by app.integrations.llm.provider for tier=cheap/mid/frontier.
LLM_TIER_CHEAP_MODEL=gemini-2.0-flash
LLM_TIER_MID_MODEL=gpt-4o-mini
LLM_TIER_FRONTIER_MODEL=gpt-4o
ANTHROPIC_PROMPT_CACHING=true

# ── LLM Observability — Langfuse (optional) ───────────────────────────────
# Leave keys empty to disable. Self-hostable; cloud regions us/eu.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Trend Detection & Web Scraping (Phase 14) ─────────────────────────────
# Reddit API (for trend detection)
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=ContentFlow/1.0

# YouTube Data API (for trending videos)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=...

# Twitter/X API (for trending topics)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=...

# Proxy for web scraping (optional, for production)
# PROXY_URL=http://username:password@proxy-server:port
# PROXY_ROTATION_ENABLED=true

