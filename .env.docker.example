# docker-compose.yml expects these to be defined.
# Copy to `.env` (same directory as docker-compose.yml) and replace every value.
# Generate strong values with: openssl rand -base64 32

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-with-strong-password
POSTGRES_DB=social-media-distribution

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=replace-me-with-username
MINIO_ROOT_PASSWORD=replace-me-with-strong-password

# Grafana (only used with `--profile observability`)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=replace-me-with-strong-password
