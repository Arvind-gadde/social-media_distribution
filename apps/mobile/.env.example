# Mobile app environment variables
#
# Required when running on a physical phone via Expo Go.
# `localhost` resolves to the phone itself, NOT your dev machine, so you must
# use the dev machine's LAN IP. Find it with:
#   ipconfig | findstr IPv4    (Windows)
#   ipconfig getifaddr en0     (macOS, Wi-Fi)
#
# Android emulator special-case: the host machine is at 10.0.2.2.
# iOS simulator: localhost works.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
