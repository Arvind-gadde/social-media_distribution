# pnpm config for monorepo.
# Expo + React Native rely on Node's hoisted node_modules layout — Metro's
# resolver does not follow pnpm symlinks reliably, leading to duplicate
# copies of react-native and the `getDevServer is not a function` runtime
# error on device. Hoist the RN ecosystem so Metro sees one copy.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*hermes*
node-linker=hoisted
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
